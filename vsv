#!/usr/bin/env bash
#
# Portable runit service manager (vsv fork)
#
# Based on: bahamas10/bash-vsv (MIT)
# Fork modifications: 5lineconfigs
#

VSV_VERSION='v1.3.5-portable'

# -----------------------------
# runit service directory detection
# -----------------------------

resolve_svdirdir() {
    # User override always wins
    if [[ -n "$SVDIR" && -d "$SVDIR" ]]; then
        return
    fi

    # Common runit layouts (order matters)
    if [[ -d /var/service ]]; then
        SVDIR=/var/service
    elif [[ -d /etc/runit/runsvdir/default ]]; then
        SVDIR=/etc/runit/runsvdir/default
    elif [[ -d /run/runit/service ]]; then
        SVDIR=/run/runit/service
    else
        echo "FATAL: no runit service directory found" >&2
        exit 1
    fi
}

resolve_svdirdir
export SVDIR

# -----------------------------
# globals
# -----------------------------

charup='✔'
chardown='X'
charunknown='?'

progname=${0##*/}
num_re='^-?[0-9]+$'
svc_re='^[a-zA-Z0-9_@\.-]+$'

shopt -s nullglob

# -----------------------------
# enter service directory safely
# -----------------------------

cd "$SVDIR" || {
    echo "FATAL: failed to enter dir: $SVDIR" >&2
    exit 1
}

# -----------------------------
# helper functions
# -----------------------------

human() {
    local seconds=$1
    ((seconds < 0)) && ((seconds *= -1))

    local times=(
        $((seconds / 31536000))
        $((seconds / 2592000))
        $((seconds / 604800))
        $((seconds / 86400))
        $((seconds / 3600))
        $((seconds / 60))
        $((seconds))
    )

    local names=(year month week day hour minute second)

    for i in "${!names[@]}"; do
        if (( times[i] > 1 )); then
            echo "${times[i]} ${names[i]}s"
            return
        elif (( times[i] == 1 )); then
            echo "${times[i]} ${names[i]}"
            return
        fi
    done

    echo "0 seconds"
}

setcolors() {
    local opt=$1

    if [[ $opt == auto ]]; then
        [[ ! -t 1 ]] && opt=off
    fi

    case "$opt" in
        on|yes|true)
            colorred=$(tput setaf 1)
            colorgreen=$(tput setaf 2)
            coloryellow=$(tput setaf 3)
            colorblue=$(tput setaf 4)
            colormagenta=$(tput setaf 5)
            colorcyan=$(tput setaf 6)
            colorgray=$(tput setaf 8)
            colorbold=$(tput bold)
            colorreset=$(tput sgr0)
            ;;
        off|no|false)
            colorred= colorgreen= coloryellow=
            colorblue= colormagenta= colorcyan=
            colorgray= colorbold= colorreset=
            ;;
    esac
}

getlogo() {
    printf '%s[%s%s%s]%s' \
        "$colorcyan" \
        "$colormagenta" "$progname" \
        "$colorcyan" \
        "$colorreset"
}

msg() {
    echo "$(getlogo)" "$colorblue$*$colorreset"
}

fatal() {
    echo "FATAL: $*" >&2
    exit 2
}

# -----------------------------
# status handling (core logic unchanged)
# -----------------------------

process_service() {
    local svc=$1
    local now=$2
    local pid when up msg state enabled

    if [[ ! -d "$svc/supervise" ]]; then
        return
    fi

    state=$(< "$svc/supervise/stat" 2>/dev/null)
    pid=$(< "$svc/supervise/pid" 2>/dev/null)

    if [[ -n "$pid" ]]; then
        when=$(stat -c %Y "$svc/supervise/pid" 2>/dev/null)
        up=$((now - when))
        msg=$(human "$up")
        enabled="true"
    else
        msg="---"
        enabled="---"
    fi

    if [[ "$state" == "run" ]]; then
        printf " ✔ %-20s run     %s %s\n" "$svc" "$enabled" "$msg"
    else
        printf " X %-20s down    %s %s\n" "$svc" "$enabled" "$msg"
    fi
}

do_status() {
    local now
    printf -v now '%(%s)T' -1

    for svc in */; do
        svc=${svc%/}
        process_service "$svc" "$now"
    done
}

do_sv_cmd() {
    sv "$@"
}

# -----------------------------
# argument parsing
# -----------------------------

setcolors auto

cmd=${1:-status}
shift || true

case "$cmd" in
    status)
        do_status "$@"
        ;;
    *)
        do_sv_cmd "$cmd" "$@"
        ;;
esac
